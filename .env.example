# ============================================================
# JobPilot AI — environment configuration
# Copy to .env and adjust. Never commit a real .env.
# ============================================================

# --- App ---
ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (CHANGE THESE) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=u5c7P0N4T6bD9K4xhrgxIB9V4gVAsl9XBEU4D9m0rhg=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Database / cache (docker compose overrides host names) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- AI provider: mock | openai | anthropic ---
# "mock" is deterministic and needs no API key — the whole demo works with it.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Gmail OAuth (optional). Create an OAuth client in Google Cloud Console,
#     add the redirect URI below, and enable the Gmail API. Only gmail.readonly is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Browser automation ---
PLAYWRIGHT_HEADLESS=true
BROWSER_ACTION_DELAY_MS=250
BROWSER_TIMEOUT_MS=15000
DEMO_ATS_BASE_URL=http://localhost:8000

# --- Automation safety rails ---
DEFAULT_DAILY_APPLICATION_LIMIT=20
MAX_DAILY_APPLICATION_LIMIT=100
DEFAULT_MIN_MATCH_SCORE=75
AUTOMATION_RETRY_LIMIT=3

# --- Demo data ---
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@jobpilot.ai
DEMO_USER_PASSWORD=DemoPass123!
