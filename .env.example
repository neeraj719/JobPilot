# ============================================================
# JobPilot AI — environment configuration
# Copy to .env and adjust. Never commit a real .env.
# ============================================================

# --- App ---
ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (CHANGE THESE) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left as a placeholder on purpose: a key published here would be a key an attacker
# already has. Local runs fall back to a development key and log a warning, so the
# demo works untouched; ENV=production refuses to start until you generate a real one.
ENCRYPTION_KEY=generate-your-own-fernet-key-see-command-above
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# COOKIE_SECURE is forced to true when ENV=production.
COOKIE_SECURE=false
# Set to true ONLY behind a single trusted reverse proxy that sets X-Real-IP /
# X-Forwarded-For. With it off, forwarding headers are ignored so a client cannot
# choose its own rate-limit bucket.
TRUST_PROXY_HEADERS=false
# ENABLE_API_DOCS=true   # /docs and /openapi.json are off in production by default
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Database / cache (docker compose overrides host names) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
# Host-side port for the Postgres container. Change this if something else on the
# machine already owns 5432 (a natively installed PostgreSQL is the usual culprit).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- AI provider: mock | ollama | openai | anthropic ---
# "mock" is deterministic and needs no API key — the whole demo works with it.
# Recommended for real AI on your own machine: "ollama", a free local model (no API key,
# no per-request cost, resume text never leaves the machine). Install Ollama, then:
#   ollama pull qwen2.5:3b-instruct
# and set:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:3b-instruct
# qwen2.5:7b-instruct writes better text but needs ~5 GB; on a 4 GB GPU it splits
# between GPU and CPU and runs several times slower.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Hosted APIs default to 60 s; with LLM_PROVIDER=ollama the default is 120 s unless set here.
# LLM_TIMEOUT_SECONDS=120

# --- Local model server (LLM_PROVIDER=ollama) ---
# Where Ollama listens. From inside a Docker container use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
# How long Ollama keeps the model in memory after a request ("0" unloads immediately).
OLLAMA_KEEP_ALIVE=10m
# Context window in tokens; 8192 fits the 3b model on a 4 GB GPU.
OLLAMA_NUM_CTX=8192
# Local embeddings (same Ollama server) rank target jobs by similarity to the resume.
# Pull once with: ollama pull embeddinggemma. Any failure falls back to the rule-based selection.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=embeddinggemma

# --- Per-user AI providers (Resume → AI Model Settings) ---
# Users bring their own OpenAI / Gemini / Anthropic keys in the app (stored Fernet-encrypted
# with ENCRYPTION_KEY). The server keys above and GOOGLE_API_KEY only serve LLM_PROVIDER.
GOOGLE_API_KEY=
# false = only the local model and the built-in rules may receive resume text.
AI_ALLOW_HOSTED_PROVIDERS=true
# Allow Ollama / OpenAI-compatible base URLs on loopback or private networks (LM Studio on
# localhost). Turn off on a multi-tenant deployment. Link-local/metadata addresses are always refused.
AI_ALLOW_LOCAL_BASE_URLS=true
# Hosted calls per user per day when the user set no limit of their own (0 = unlimited).
AI_DEFAULT_DAILY_CALL_LIMIT=500
AI_USAGE_RETENTION_DAYS=400
AI_TEST_RATE_LIMIT_PER_MINUTE=10

# --- Gmail OAuth (optional). Create an OAuth client in Google Cloud Console,
#     add the redirect URI below, and enable the Gmail API. Only gmail.readonly is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Browser automation ---
PLAYWRIGHT_HEADLESS=true
# Keep Chromium's sandbox on. Only set true where the container runtime blocks it.
BROWSER_DISABLE_SANDBOX=false
BROWSER_ACTION_DELAY_MS=250
BROWSER_TIMEOUT_MS=15000
DEMO_ATS_BASE_URL=http://localhost:8000

# --- Automation safety rails ---
DEFAULT_DAILY_APPLICATION_LIMIT=20
MAX_DAILY_APPLICATION_LIMIT=100
DEFAULT_MIN_MATCH_SCORE=75
AUTOMATION_RETRY_LIMIT=3

# --- Demo data ---
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@jobpilot.ai
DEMO_USER_PASSWORD=DemoPass123!
